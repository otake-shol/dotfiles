#!/usr/bin/env python3
"""Orca automation precheck: run the dev triage only when PR/CI state changed.

Collects open PRs and default-branch workflows whose latest run failed, for every
GitHub repo registered in Orca. Exit 0 (run the agent) only when there are findings
and they differ from the last triaged fingerprint; otherwise exit 1 (skip the run).
The findings are written to pending.json for the agent to read.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

DEFAULT_STATE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "orca-dev-triage"
RUN_SCAN_LIMIT = 30


def run_json(args):
    """Run a command and parse its stdout as JSON."""
    out = subprocess.run(args, check=True, capture_output=True, text=True, timeout=60)
    return json.loads(out.stdout or "null")


def github_repos(orca_repo_list):
    """Return sorted owner/name slugs for GitHub repos in `orca repo list` output."""
    slugs = set()
    for repo in orca_repo_list.get("result", {}).get("repos", []):
        key = (repo.get("gitRemoteIdentity") or {}).get("canonicalKey") or ""
        prefix = "github.com/"
        if key.startswith(prefix) and key.count("/") == 2:
            slugs.add(key[len(prefix):])
    return sorted(slugs)


def failing_workflows(runs):
    """Return the latest run per workflow when that latest run failed."""
    latest = {}
    for run in runs:
        name = run.get("workflowName")
        if name and run.get("status") == "completed" and name not in latest:
            latest[name] = run
    return [
        {"workflow": name, "runId": run["databaseId"], "url": run.get("url")}
        for name, run in sorted(latest.items())
        if run.get("conclusion") in ("failure", "timed_out", "startup_failure")
    ]


def fingerprint(findings):
    """Stable hash of what the agent would triage (ids only, not timestamps of checks)."""
    keys = []
    for item in findings:
        keys += [f"{item['repo']}#pr{pr['number']}@{pr['updatedAt']}" for pr in item["prs"]]
        keys += [f"{item['repo']}#run{run['runId']}" for run in item["failures"]]
    return hashlib.sha256("\n".join(sorted(keys)).encode()).hexdigest()[:16]


def collect(repos):
    """Query GitHub for open PRs and failing default-branch workflows per repo."""
    findings, errors = [], []
    for slug in repos:
        try:
            branch = run_json(["gh", "repo", "view", slug, "--json", "defaultBranchRef"])[
                "defaultBranchRef"]["name"]
            prs = run_json(["gh", "pr", "list", "-R", slug, "--state", "open",
                            "--json", "number,title,updatedAt,isDraft,author,url"])
            runs = run_json(["gh", "run", "list", "-R", slug, "--branch", branch,
                             "--limit", str(RUN_SCAN_LIMIT),
                             "--json", "databaseId,workflowName,status,conclusion,url"])
        except (subprocess.SubprocessError, json.JSONDecodeError, KeyError, TypeError) as err:
            errors.append({"repo": slug, "error": str(err)[:200]})
            continue
        failures = failing_workflows(runs)
        if prs or failures:
            findings.append({"repo": slug, "defaultBranch": branch,
                             "prs": prs, "failures": failures})
    return findings, errors


def atomic_write(path, text):
    """Write text via a temp file in the same directory, then replace."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, path)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state-dir", type=Path, default=DEFAULT_STATE_DIR)
    parser.add_argument("--force", action="store_true", help="ignore the last fingerprint")
    args = parser.parse_args(argv)

    repos = github_repos(run_json(["orca", "repo", "list", "--json"]))
    findings, errors = collect(repos)
    if not findings:
        print(f"skip: no open PRs or failing workflows across {len(repos)} repos")
        return 1

    current = fingerprint(findings)
    last_file = args.state_dir / "last.fingerprint"
    last = last_file.read_text().strip() if last_file.exists() else ""
    if current == last and not args.force:
        print(f"skip: findings unchanged since last triage ({current})")
        return 1

    args.state_dir.mkdir(parents=True, exist_ok=True)
    pending = {"fingerprint": current, "repos": repos, "findings": findings, "errors": errors}
    atomic_write(args.state_dir / "pending.json",
                 json.dumps(pending, ensure_ascii=False, indent=2) + "\n")
    print(f"run: {len(findings)} repos need triage ({current})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
