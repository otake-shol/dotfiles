#!/usr/bin/env python3
"""Reject private material before it is committed or pushed from this repository."""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path


TOKEN_RULES = (
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9_]{20,}\b")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("OpenAI key", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{20,}\b")),
    ("Anthropic key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
)
PRIVATE_MARKER = re.compile(
    r'(?<![/\\])-----BEGIN (?:RSA |EC |OPENSSH |DSA |ENCRYPTED |)?PRIVATE KEY-----'
)
AWS_DOCUMENTATION_EXAMPLE = "AKIAIOSFODNN7EXAMPLE"
ZERO_SHA = "0" * 40
# These existing blobs are metadata-only exemptions, not verified content.
# Any change to these protected files must be blocked without reading it.
UNREAD_BASELINES = {
    "stow/claude/.claude/.env.tpl": {"40b0328d151a111aabd6f2b9573a2b04af1673e3"},
    "stow/ssh/.ssh/config": {
        "19d69cd624c5918e0720bff4838ac9332f4b2d73",
        "d4479573e3d44ed82fa60bc0709798ac173c9b30",
        "e5f86fc6c4b5e529dcdbfb961c4190afc97b4efc",
    },
}


def run_git(args, text=False, check=True):
    return subprocess.run(
        ["git", *args], cwd=Path.cwd(), check=check, text=text,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )


def forbidden_path(path):
    parts = Path(path).parts
    name = Path(path).name
    lower_path = path.lower()
    if name == ".env" or name.startswith(".env."):
        return "environment file"
    if "1password" in lower_path:
        return "1Password file"
    if any(part == ".ssh" for part in parts):
        return "SSH path"
    if "credentials" in lower_path:
        return "credentials file"
    if name.lower().endswith((".key", ".p8", ".pem")):
        return "private-key file"
    if name == "auth.json":
        return "authentication file"
    if name == "blocked-phrases.txt":
        return "private phrase list"
    if name.endswith(".local.md"):
        return "local note"
    if any(parts[index:index + 3] == (".claude", "skills", "fact")
           for index in range(len(parts) - 2)):
        return "private fact skill"
    return None


def load_phrases(path):
    if not path.exists():
        return ()
    return tuple(line.strip() for line in path.read_text(encoding="utf-8").splitlines()
                 if line.strip() and not line.lstrip().startswith("#"))


def safe_path(path, phrases):
    for phrase in phrases:
        path = path.replace(phrase, "<private>")
    for _, pattern in TOKEN_RULES:
        path = pattern.sub("<token>", path)
    return path.encode("unicode_escape").decode("ascii")


def is_placeholder(path, value):
    if value == AWS_DOCUMENTATION_EXAMPLE:
        return True
    suffix = re.sub(r"^(?:gh[pousr]_|github_pat_|sk-(?:proj-|ant-)?)", "", value)
    return Path(path).name == ".gitconfig" and len(suffix) > 8 and len(set(suffix)) == 1


class Scanner:
    def __init__(self, phrases):
        self.phrases = phrases
        self.findings = []
        self.seen_blobs = set()

    def report(self, path, category, line=None, commit=None):
        suffix = f":{line}" if line else ""
        revision = f" commit {commit}" if commit else ""
        self.findings.append(f"{safe_path(path, self.phrases)}{suffix}: {category}{revision}")

    def scan_blob(self, path, mode, oid, commit=None):
        if oid in UNREAD_BASELINES.get(path, ()) and mode == "100644":
            return
        restriction = forbidden_path(path)
        if restriction:
            self.report(path, restriction, commit=commit)
            return
        if mode == "120000":
            return
        cache_key = (oid, Path(path).name == ".gitconfig")
        if cache_key in self.seen_blobs:
            return
        self.seen_blobs.add(cache_key)
        raw = run_git(["cat-file", "-p", oid]).stdout
        content = raw.decode("utf-8", "replace")
        for number, line in enumerate(content.splitlines(), 1):
            for category, pattern in TOKEN_RULES:
                if any(not is_placeholder(path, match.group()) for match in pattern.finditer(line)):
                    self.report(path, category, number, commit)
            if PRIVATE_MARKER.search(line):
                self.report(path, "private-key marker", number, commit)
            if any(phrase in line for phrase in self.phrases):
                self.report(path, "private phrase", number, commit)

    def scan_commit_message(self, commit):
        message = run_git(["show", "-s", "--format=%B", commit]).stdout.decode("utf-8", "replace")
        for number, line in enumerate(message.splitlines(), 1):
            for category, pattern in TOKEN_RULES:
                if pattern.search(line):
                    self.report("commit message", category, number, commit[:12])
            if PRIVATE_MARKER.search(line):
                self.report("commit message", "private-key marker", number, commit[:12])
            if any(phrase in line for phrase in self.phrases):
                self.report("commit message", "private phrase", number, commit[:12])


def split_nul(data):
    return [item.decode("utf-8", "surrogateescape") for item in data.split(b"\0") if item]


def scan_index(scanner):
    for entry in split_nul(run_git(["ls-files", "-s", "-z"]).stdout):
        metadata, _, path = entry.partition("\t")
        fields = metadata.split()
        if len(fields) == 3 and path:
            scanner.scan_blob(path, fields[0], fields[1])


def commit_tree(commit):
    return split_nul(run_git(["ls-tree", "-r", "-z", commit]).stdout)


def scan_push(scanner):
    refs = [line.split() for line in sys.stdin.read().splitlines() if line.split()]
    commits = []
    for local_ref, local_sha, _remote_ref, remote_sha, *_ in refs:
        if local_sha == ZERO_SHA:
            continue
        args = ["rev-list", local_sha] if remote_sha == ZERO_SHA else ["rev-list", f"{remote_sha}..{local_sha}"]
        result = run_git(args, text=True, check=False)
        if result.returncode:
            result = run_git(["rev-list", local_sha], text=True)
        commits.extend(result.stdout.splitlines())
    for commit in dict.fromkeys(commits):
        short = commit[:12]
        scanner.scan_commit_message(commit)
        for entry in commit_tree(commit):
            metadata, _, path = entry.partition("\t")
            fields = metadata.split()
            if len(fields) >= 3 and path:
                scanner.scan_blob(path, fields[0], fields[2], short)


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--index", action="store_true")
    mode.add_argument("--pre-push", action="store_true")
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    parser.add_argument("--rules-file", type=Path,
                        default=config_home / "dotfiles-local/privacy/blocked-phrases.txt")
    args = parser.parse_args()
    scanner = Scanner(load_phrases(args.rules_file))
    scan_index(scanner) if args.index else scan_push(scanner)
    if scanner.findings:
        for finding in scanner.findings:
            print(f"public-content check: {finding}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
